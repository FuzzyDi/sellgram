# Copy this file to .env.prod and fill in every CHANGE_ME value before
# deploying. Do not start production with any CHANGE_ME left in place —
# REDIS_PASSWORD, JWT_SECRET, JWT_REFRESH_SECRET, SYSTEM_JWT_SECRET,
# SYSTEM_ADMIN_PASSWORD, ENCRYPTION_KEY, and S3_SECRET_KEY are live
# credentials/signing keys: an unfilled CHANGE_ME there is a known,
# public value (this file) and lets anyone forge auth tokens or decrypt
# stored data. .env.prod itself must stay untracked (see .gitignore) —
# never commit real values.
SERVER_IP=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
SYSTEM_JWT_SECRET=CHANGE_ME
SYSTEM_ADMIN_EMAIL=CHANGE_ME
SYSTEM_ADMIN_PASSWORD=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
APP_URL=CHANGE_ME
ADMIN_URL=CHANGE_ME
MINIAPP_URL=CHANGE_ME
LANDING_URL=CHANGE_ME
SUPPORT_EMAIL=CHANGE_ME
PRIVACY_EMAIL=CHANGE_ME
BILLING_EMAIL=CHANGE_ME
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=CHANGE_ME
LEGAL_ENTITY_NAME=CHANGE_ME
LEGAL_ENTITY_SHORT_NAME=CHANGE_ME
LEGAL_ENTITY_ADDRESS=CHANGE_ME
LEGAL_ENTITY_INN=CHANGE_ME
BILLING_BANK_NAME=CHANGE_ME
BILLING_BANK_ACCOUNT=CHANGE_ME
BILLING_RECIPIENT=CHANGE_ME
BILLING_INN=CHANGE_ME
BILLING_MFO=CHANGE_ME
BILLING_PAYMENT_NOTE=CHANGE_ME
GA_MEASUREMENT_ID=CHANGE_ME
YANDEX_METRIKA_ID=CHANGE_ME
ALLOW_DEV_AUTH_BYPASS=CHANGE_ME
MINIAPP_INITDATA_MAX_AGE_SEC=CHANGE_ME
PRISMA_SEED=CHANGE_ME
NGINX_HTTP_PORT=CHANGE_ME
NGINX_HTTPS_PORT=CHANGE_ME
SSL_MODE=CHANGE_ME
SSL_COMMON_NAME=CHANGE_ME
MONITOR_HEALTH_URL=CHANGE_ME
MONITOR_TIMEOUT_SEC=CHANGE_ME
MONITOR_TELEGRAM_BOT_TOKEN=CHANGE_ME
MONITOR_TELEGRAM_CHAT_ID=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=CHANGE_ME
